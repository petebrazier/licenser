# Storage (Bonza's Supabase; the licence tables are closed to anon)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Locks the admin pages. The API under /api/v1 authenticates by licence key.
ADMIN_PASSWORD=

# base64 of 32 random bytes. Encrypts the leased credentials at rest.
SECRET_ENCRYPTION_KEY=

# base64 of an Ed25519 private key in PKCS#8 PEM. Signs every lease.
# The matching public key goes into each installation as LICENCE_PUBLIC_KEY.
LEASE_SIGNING_KEY=
